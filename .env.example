# .env.example for FoodNote BE
# MySQL connection
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/foodnote_db"

# Cloudflare R2 credentials (example)
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key_id"
R2_SECRET_ACCESS_KEY="your_secret_access_key"
R2_BUCKET_NAME="foodnote-assets"

# Cloudflare Images API (optional)
CLOUDFLARE_IMAGES_ACCOUNT_HASH="your_account_hash"
CLOUDFLARE_IMAGES_API_TOKEN="your_api_token"

# Firebase service account JSON path (for admin SDK)
FIREBASE_SERVICE_ACCOUNT="./serviceAccountKey.json"
